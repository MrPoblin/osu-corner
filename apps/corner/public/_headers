# This corner's own policy — the site it is mounted under has its own, and they differ.
#
# Every host below fails SILENTLY if it is missing: a blocked image or fetch looks like a
# rendering bug, not a policy problem.
#
#   img-src https://assets.ppy.sh
#     Cover art. No CORS restriction, 28-day cache, so the browser fetches it directly.
#
#   connect-src / media-src https://osu.direct https://catboy.best
#     The .osu file and the audio, which this project does not host. Must match
#     [mirrors] in osu-corner.toml.
#
#   The R2 host for the .osr files is NOT listed yet — it is unknown until the bucket exists,
#   and it will need adding to both connect-src and media-src when it does.
#
# style-src 'unsafe-inline' is kept: removing it blocks inline style, which React style props
# rely on. HSTS omits `preload` deliberately — submission is effectively irreversible.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://assets.ppy.sh; font-src 'self'; connect-src 'self' https://osu.direct https://catboy.best; media-src 'self' https://osu.direct https://catboy.best; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Both paths are listed because this file cannot know its own mount path — one is inert.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/osu/assets/*
  Cache-Control: public, max-age=31536000, immutable
