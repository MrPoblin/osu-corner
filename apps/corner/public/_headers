# This corner's own policy — the site it is mounted under has its own, and they differ.
#
# Every host below fails SILENTLY if it is missing: a blocked image or fetch looks like a
# rendering bug, not a policy problem.
#
#   img-src https://assets.ppy.sh
#     Cover art. No CORS restriction, 28-day cache, so the browser fetches it directly.
#
#   connect-src / media-src https://osu.direct https://catboy.best
#     The .osu file and the audio, which this project does not host. Must match
#     [mirrors] in osu-corner.toml.
#
#   connect-src / media-src __STORAGE_ORIGIN__
#     The replay `.osr` files and the index, fetched by the browser straight from the bucket's own
#     hostname rather than through a Worker, so a replay view is a CDN read and not an invocation
#     (§9). The hostname is deliberately NOT written here: this file is committed and the host is
#     per-deployment, so it is injected at build time from `storage.public_base` in the config by
#     tools/hoist-headers.mjs. A clone must not inherit somebody else's hostname (§14).
#
#     An empty `storage.public_base` removes the entry rather than leaving a broken one, which is
#     the right policy for a deployment serving the replays as its own static assets. Wrong either
#     way it fails SILENTLY — a blocked fetch looks like a rendering bug, not a policy problem —
#     so the build prints what it injected and says so when it injected nothing.
#
# style-src 'unsafe-inline' is kept: removing it blocks inline style, which React style props
# rely on. HSTS omits `preload` deliberately — submission is effectively irreversible.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://assets.ppy.sh; font-src 'self'; connect-src 'self' https://osu.direct https://catboy.best __STORAGE_ORIGIN__; media-src 'self' https://osu.direct https://catboy.best __STORAGE_ORIGIN__; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Both paths are listed because this file cannot know its own mount path — one is inert.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/osu/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The index files. They only change when a new ingest runs, and between ingests they are the same
# ~300 KB brotli on every visit — so five minutes of freshness and a day of stale-while-revalidate:
# a repeat visit paints from the browser's own copy while the revalidation happens behind it. Left to
# the static-asset default (`max-age=0, must-revalidate`) all four files cost a round trip every load.
/osu/index-*.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/index-*.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Replay files. A `.osr` is immutable once written — its name is the map's hash plus the score's
# timestamp — so it can be kept for a year. Poblin's own replays are never read from here (the
# browser fetches them from the bucket's hostname); this is the rule that matters to a clone that
# uploads its replays as its own static assets.
/osu/replays/*
  Cache-Control: public, max-age=31536000, immutable

/replays/*
  Cache-Control: public, max-age=31536000, immutable
