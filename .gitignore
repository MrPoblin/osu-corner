# Secrets. `.dev.vars` is read by `wrangler dev`; production uses `wrangler secret put`.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
*.pem
*.key

# Your own config values. The committed osu-corner.toml holds generic defaults; this file is
# merged over them, so it is yours and is never shared.
osu-corner.local.toml

node_modules/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

target/
dist/
# Emitted by `wrangler types`.
worker-configuration.d.ts

# The local working set: the played .osu files, the .osr files and the ingest ledger. Materialised
# out of the game folders on first ingest — it belongs to whoever runs the ingest, not to the repo.
library/

.wrangler/

.DS_Store
Thumbs.db
.idea/
.vscode/*

# The index files. Ingest output, written into `library/`.
#
# A copy here is what the dev server serves, and what a build falls back to when
# `storage.public_base` is empty — the clone that serves its own index. With a `public_base` set the
# app fetches them from the storage host instead, so CI, which has no copy, still deploys correctly.
/apps/corner/public/index-*.json

# The profile snapshots, for exactly the same reasons — ingest output, never committed. The dev
# server reads a copy here so `pnpm dev` shows a real card without a Worker running.
/apps/corner/public/profile-*.json
